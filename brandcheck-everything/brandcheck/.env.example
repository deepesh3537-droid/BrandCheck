# BrandCheck: environment variables template
# ONE file at the repo root. Copy to `.env` (git-ignored) and fill in real values.
# NEVER commit `.env`. This file (.env.example) is safe to commit — it has no real secrets.
# The server reads it through server/src/config/env.js; Vite's envDir points to the repo root.

# =============================================================================
# SECTION 1: LOCAL DEVELOPMENT (copy these to .env, fill in your local values)
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000
# The browser origin that CORS will allow (your local Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (local PostgreSQL by default) ---
# For local: postgres://USERNAME:PASSWORD@localhost:5432/brandcheck
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/brandcheck
# Set to true only for hosted databases that require TLS (Neon, Supabase, Render)
DATABASE_SSL=false

# --- Authentication ---
# Use a long random value — generate with: openssl rand -hex 32
# MINIMUM 32 characters. Never use the development placeholder in production.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=8h
# false for local dev (HTTP); true REQUIRED for production (HTTPS cross-site cookies)
COOKIE_SECURE=false
INVITE_EXPIRY_HOURS=168

# --- Uploads ---
MAX_UPLOAD_MB=2
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md

# --- Local AI models (Ollama) ---
# Ollama must be running locally on port 11434 with the model pulled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_TIMEOUT_MS=60000
# Where HuggingFace / ONNX model files are cached, relative to server/ (git-ignored)
MODEL_CACHE_DIR=./.model-cache
# true = run rules-only review when Ollama is unavailable (safe default)
ALLOW_RULES_ONLY_FALLBACK=true

# --- Optional: hosted cloud LLM inference (Groq free tier — no cost) ---
# Leave blank to use Ollama locally or rules-only fallback.
# Get a free key at: https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# --- Client / Vite (only non-secret values allowed here — exposed to browser) ---
# Local dev: points to your local server
VITE_API_BASE_URL=http://localhost:4000/api


# =============================================================================
# SECTION 2: RENDER PRODUCTION (set these as Environment Variables in Render dashboard)
# Never put real production values in this file — use the Render dashboard.
# =============================================================================

# NODE_ENV=production
# PORT=10000                                  (Render assigns this automatically)
# CLIENT_ORIGIN=https://brandcheck-two.vercel.app
# DATABASE_URL=<Render/Neon PostgreSQL connection string>
# DATABASE_SSL=true
# JWT_SECRET=<generate: openssl rand -hex 32>
# COOKIE_SECURE=true
# ALLOW_RULES_ONLY_FALLBACK=true
# LLM_API_KEY=<optional Groq key for AI inference>
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant


# =============================================================================
# SECTION 3: VERCEL PRODUCTION (set in Vercel Dashboard > Settings > Env Vars)
# =============================================================================

# VITE_API_BASE_URL=https://brandcheck.onrender.com/api
# (This is also pre-set in .env.production — committed, safe, no secrets)

