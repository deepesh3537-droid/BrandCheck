# BrandCheck: environment variables template
# One file at the repo root: copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.
# The server reads it through server/src/config/env.js; Vite's envDir points to the repo root.
# No paid APIs are used (budget: ₹0). Do not add paid-service keys.

# --- Server ---
NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (local PostgreSQL by default) ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/brandcheck
# Set to true only if a hosted database requires TLS (for example Supabase Free)
DATABASE_SSL=false

# --- Authentication ---
# Use a long random value, for example the output of: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
INVITE_EXPIRY_HOURS=168

# --- Uploads ---
MAX_UPLOAD_MB=2
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md

# --- Local models ---
# Ollama server (local) and the Qwen model tag you confirmed in the model spike
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
MODEL_TIMEOUT_MS=60000
# Where Hugging Face / ONNX model files are cached, relative to server/ (git-ignored)
MODEL_CACHE_DIR=./.model-cache
# If true, the review runs rules-only when a model is unavailable
ALLOW_RULES_ONLY_FALLBACK=true

# --- Client (Vite). Only non-secret values may be exposed to the browser ---
VITE_API_BASE_URL=http://localhost:4000/api

# --- Optional: hosted Supabase Postgres (only after verifying current free-tier terms) ---
# Not required for local development. Never expose a service key to the client.
# SUPABASE_DB_URL=
